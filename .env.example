# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Twelve Data API Key for Forex & XAUUSD data
# Free tier: 800 req/day — get from https://twelvedata.com/
# Without this, forex data uses 'demo' key (very limited)
TWELVE_DATA_API_KEY=your_api_key_here
